{
  "permissions": {
    "allow": [
      "Bash(wc -l *.js)",
      "Bash(npm install:*)",
      "Bash(npx http-server:*)",
      "Bash(netstat -ano)",
      "Bash(findstr :3000)",
      "Bash(taskkill /PID 37088 /F)",
      "Bash(cmd /c \"taskkill /PID 37088 /F\")",
      "Bash(cmd /c \"taskkill /F /PID 37088\")",
      "Bash(cmd /c \"tasklist /FI \"\"PID eq 37088\"\"\")",
      "Bash(powershell -Command \"Stop-Process -Id 37088 -Force; Write-Host ''done''\")",
      "Bash(powershell -Command \"netstat -ano | Select-String '':3000''\")"
    ]
  }
}
